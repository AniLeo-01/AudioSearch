# Copy to .env (never commit real secrets). Every setting is documented in src/audiosearch/config.py.

# --- storage --------------------------------------------------------------------------------------
AUDIOSEARCH_DATABASE_URL=postgresql://audiosearch:audiosearch@localhost:5432/audiosearch
# Separate schemas give blue/green re-indexing (e.g. when switching embedding models).
AUDIOSEARCH_DB_SCHEMA=public
AUDIOSEARCH_DB_POOL_MAX=8
AUDIOSEARCH_DB_STATEMENT_TIMEOUT_MS=5000

# --- pipeline -------------------------------------------------------------------------------------
AUDIOSEARCH_ASR_MODEL=large-v3-turbo        # faster-whisper model (base.en for fast/low-memory)
AUDIOSEARCH_ASR_DEVICE=cpu                  # cuda for GPU transcription
AUDIOSEARCH_ASR_COMPUTE_TYPE=int8           # float16 on GPU
AUDIOSEARCH_TRANSCRIPT_SET=large-v3-turbo   # data/transcripts/<set> used by `index`
AUDIOSEARCH_NUM_SPEAKERS=2

# --- retrieval ------------------------------------------------------------------------------------
AUDIOSEARCH_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
AUDIOSEARCH_RERANK=false                    # cross-encoder second stage (+~250 ms on CPU)
AUDIOSEARCH_RRF_K=10
AUDIOSEARCH_LEXICAL_COVERAGE=true
AUDIOSEARCH_PHONETIC_EXPANSION=true

# --- service --------------------------------------------------------------------------------------
AUDIOSEARCH_LOG_LEVEL=INFO
AUDIOSEARCH_LOG_FORMAT=console              # json in production
AUDIOSEARCH_API_CORS_ORIGINS=["http://localhost:8000"]
